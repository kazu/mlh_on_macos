#!/usr/bin/make -f

%:
	dh $@

# dh_auto_build replaces HOME, which hides rustup's installed toolchain.
override_dh_auto_build:
	$(MAKE) build

override_dh_auto_test:
	$(MAKE) -o build test

override_dh_auto_install:
	$(MAKE) -o build install PREFIX=/usr DESTDIR="$(CURDIR)/debian/mlh-ibus"

# dwz does not understand Swift's .debug_names section.
override_dh_dwz:

override_dh_shlibdeps:
	dh_shlibdeps -ldebian/mlh-ibus/usr/lib/mlh -- --ignore-missing-info
